{
  "name": "task3-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync-env": "node scripts/sync-env.mjs",
    "start": "node scripts/sync-env.mjs && ng serve --port 4200",
    "build": "node scripts/sync-env.mjs && ng build",
    "watch": "node scripts/sync-env.mjs && ng build --watch --configuration development",
    "test": "node scripts/sync-env.mjs && ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}